 "regex_rules": {
  "_why": "要看上下文的詞。pattern 比對簡體原文（Python 正規式），命中處整段換成 tw 並受保護；tw 裡的 \\1 代表第 1 組（單獨做 OpenCC）。深板岩礦與「X原礦」依原版（深层钻石矿石 → 深板岩鑽石礦、粗铜 → 銅原礦），模組自帶 zh_tw 也是多數（深板岩 7／深層 6、原礦 5／粗 2）；粗X 只認金屬字（钅部與「金」）。原版 entity.minecraft.wither 官方譯名是「凋零怪」，但「凋灵合金、凋灵蜜蜂、凋灵骷髅…」這類複合詞在台灣慣用「凋零」前綴，所以只有「凋灵」單獨成詞（後面不接漢字，或接虛詞）時才譯「凋零怪」。",
  "rules": [
   {"pattern": "(?<=[0-9])天后", "tw": "天後"},
   {"pattern": "深层(?=[\\u4e00-\\u9fff]{1,3}矿石)", "tw": "深板岩"},
   {"pattern": "粗([\\u9485-\\u9576金])(?=$|[^\\u4e00-\\u9fff]|[块的和与、，])", "tw": "\\1原礦"},
   {"pattern": "有云(?=[，,。])", "tw": "有雲"},
   {"pattern": "(?<![皇王蜂天母])后(?=[它他她我你其便就才再即会可将又也还都被，,。！？、；：\\s]|$)", "tw": "後"},
   {"pattern": "恶魂(?=$|[^\\u4e00-\\u9fff]|[的和或与也即就进身无处炸死奖会被在是战打后时前])", "tw": "地獄幽靈"},
   {"pattern": "凋灵(?=$|[^\\u4e00-\\u9fff]|[的和或与也即就进身无处炸死奖会被在是战打后时前])", "tw": "凋零怪"}
  ]
 },

 "post_chars": {
  "_why": "OpenCC 輸出後的字形統一。原版 zh_tw 全檔「台」34 次、「臺」0 次，s2twp 卻會產生「臺」（臺階、平臺…）。只作用於 OpenCC 產出的部分，不碰詞表與名稱字典的結果。",
  "臺": "台",
  "箇": "個"
 },

 "check_allow_words": {
  "_why": "scripts/zh_tw/check_tw.py 的放行詞：這些詞裡的字在台灣正體中也是正確寫法，只是原版 zh_tw 剛好沒出現過，判定器會誤報。只收整個詞，不收單字。",
  "words": ["傢伙", "干涉", "干擾", "干預", "若干", "相干", "皇后", "蜂后", "王后", "影后", "茶几", "几案", "征服", "征戰", "征途", "批准", "吁吁", "馥郁", "濃郁", "鬱郁", "干係", "伙食", "興高采烈", "遠征", "出征", "征兆", "夸克", "丰采", "風采", "神采", "采邑", "後裔", "皇后史萊姆"]
 },

 "name_dict_exclude": {
  "_why": "名稱字典會把原版官方整條名稱（cn → tw）當作詞套進所有文字裡，讓任務書、導覽書裡提到的名字與 JEI 裡的物品名一致。以下名稱太像一般詞彙，套進正文會誤傷，所以不進字典（原版鍵本身仍照官方值出）。",
  "names": ["流浪者", "守卫者", "冰霜行者", "幸运值", "水下呼吸", "穿透", "穿刺", "激流", "无限", "力量", "效率", "耐久", "保护", "锋利", "击退", "冲击", "忠诚", "引雷", "致密", "破甲", "风爆", "失明", "黑暗", "虚弱", "饥饿", "发光", "飘浮", "缓降", "抗火", "幸运", "中毒", "饱和", "迅捷", "缓慢", "生命恢复", "隐身", "夜视", "跳跃提升", "生命提升", "寄生", "渗浆", "盘丝", "蓄风", "速度"]
 }
}
